# Database
DATABASE_URL=postgresql://midnight:midnight_secret@localhost:5432/midnight_dark_pool

# Midnight Network
MIDNIGHT_DEVNET_URL=http://localhost:8080
MIDNIGHT_NETWORK_ID=devnet

# Sequencer
WEBSOCKET_PORT=8081
HTTP_PORT=3000
SEQUENCER_PRIVATE_KEY=your_private_key_here
SEQUENCER_PUBLIC_KEY=your_public_key_here

# Prover
PROVER_URL=http://localhost:3001
WORKER_THREADS=4

# Batch Configuration
BATCH_SIZE=50
BATCH_TIMEOUT_MS=3000

# Frontend
NEXT_PUBLIC_SEQUENCER_URL=ws://localhost:8081
NEXT_PUBLIC_NETWORK_URL=http://localhost:8080

# Logging
LOG_LEVEL=info
