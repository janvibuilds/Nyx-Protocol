{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@contracts/*": ["./contracts/*"],
      "@sequencer/*": ["./sequencer/*"],
      "@worker/*": ["./worker/*"]
    }
  },
  "include": ["src/**/*", "contracts/**/*", "sequencer/**/*", "worker/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
