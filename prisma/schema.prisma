generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            String   @id @default(uuid())
  clientOrderId String   @unique
  pair          String
  side          String
  price         Decimal
  amount        Decimal
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  batchId       String?

  buyMatches    Match[]  @relation("BuyOrder")
  sellMatches   Match[]  @relation("SellOrder")
  batch         Batch?   @relation(fields: [batchId], references: [id])

  @@index([pair, side, price])
  @@index([status])
  @@index([clientOrderId])
}

model Match {
  id            String   @id @default(uuid())
  buyOrderId    String
  sellOrderId   String
  price         Decimal
  amount        Decimal
  matchedAt     DateTime @default(now())

  buyOrder      Order    @relation("BuyOrder", fields: [buyOrderId], references: [id])
  sellOrder     Order    @relation("SellOrder", fields: [sellOrderId], references: [id])
  settlement    Settlement?

  @@index([buyOrderId])
  @@index([sellOrderId])
}

model Settlement {
  id            String   @id @default(uuid())
  matchId       String   @unique
  txHash        String?  @unique
  proofHash     String?
  status        String   @default("PENDING")
  submittedAt   DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime @default(now())

  match         Match    @relation(fields: [matchId], references: [id])

  @@index([matchId])
  @@index([status])
}

model Batch {
  id            String   @id @default(uuid())
  orderCount    Int
  proofHash     String?
  txHash        String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]

  @@index([status])
}

model SequencerState {
  id            String   @id @default("singleton")
  lastOrderId   String?
  lastBatchId   String?
  stateRoot     String?
  updatedAt     DateTime @updatedAt
}
