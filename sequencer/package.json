{
  "name": "midnight-dark-pool-sequencer",
  "version": "0.1.0",
  "description": "High-frequency sequencer for Midnight Dark Pool",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "chmod +x node_modules/.bin/* 2>/dev/null || true",
    "dev": "npx ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration",
    "test:load": "jest --testPathPattern=load",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "dotenv": "^16.6.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
