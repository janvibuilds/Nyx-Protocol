{
  "name": "midnight-dark-pool",
  "version": "0.1.0",
  "description": "MEV-resistant dark pool built on Midnight Network",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:sequencer\" \"npm run dev:frontend\"",
    "dev:sequencer": "cd sequencer && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:sequencer && npm run build:frontend",
    "build:sequencer": "cd sequencer && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "test": "npm run test:sequencer && npm run test:frontend",
    "test:sequencer": "cd sequencer && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:integration": "npm run test:integration:sequencer",
    "test:integration:sequencer": "cd sequencer && npm run test:integration",
    "test:load": "cd sequencer && npm run test:load",
    "lint": "npm run lint:sequencer && npm run lint:frontend",
    "lint:sequencer": "cd sequencer && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "demo:simulate": "cd cli && npm run simulate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js": "^4.0.4",
    "@midnight-ntwrk/compact-js": "^2.5.0",
    "@prisma/client": "^5.0.0",
    "ws": "^8.16.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "typescript": "^5.3.0",
    "prettier": "^3.2.0",
    "eslint": "^8.56.0",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
